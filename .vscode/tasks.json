{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon: build",
      "type": "shell",
      "command": "colcon --log-base /workspace/log build --symlink-install --build-base /workspace/build --install-base /workspace/install",
      "options": {
        "cwd": "/workspace"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$colcon"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "colcon: build (this package)",
      "type": "shell",
      "command": "colcon --log-base /workspace/log build --symlink-install --build-base /workspace/build --install-base /workspace/install --packages-select maze_bot",
      "options": {
        "cwd": "/workspace"
      },
      "group": "build",
      "problemMatcher": ["$colcon"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "colcon: clean",
      "type": "shell",
      "command": "rm -rf /workspace/build /workspace/install /workspace/log",
      "options": {
        "cwd": "/workspace"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
